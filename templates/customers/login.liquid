<section class="section">
  <div class="container container--narrow account-form">
    <h1 class="h2">Sign in</h1>

    <div id="RecoverPassword" class="account-form__recover" hidden>
      <h2 class="h4">Reset your password</h2>
      <p class="muted">We'll email you a link to reset it.</p>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" role="status">Check your inbox for a reset link.</p>
        {%- endif -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label class="field__label" for="RecoverEmail">Email</label>
          <input class="field__input" type="email" name="email" id="RecoverEmail" autocomplete="email" required>
        </div>
        <div class="button-row">
          <button type="submit" class="btn btn--primary">Send reset link</button>
          <a href="#login" class="btn btn--ghost" data-toggle-recover>Cancel</a>
        </div>
      {%- endform -%}
    </div>

    <div id="CustomerLogin">
      {%- form 'customer_login' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label class="field__label" for="CustomerEmail">Email</label>
          <input class="field__input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">Password</label>
            <input class="field__input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password">
          </div>
        {%- endif -%}
        <button type="submit" class="btn btn--primary btn--block btn--lg">Sign in</button>
      {%- endform -%}
      <p class="account-form__links">
        <a href="#recover" data-toggle-recover>Forgot your password?</a>
        &middot;
        <a href="{{ routes.account_register_url }}">Create an account</a>
      </p>
    </div>

    {%- if shop.checkout.guest_login -%}
      <hr>
      <h2 class="h4">Continue as a guest</h2>
      {%- form 'guest_login' -%}
        <button type="submit" class="btn btn--secondary">Continue to checkout</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>
<script>
  document.querySelectorAll('[data-toggle-recover]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      var r = document.getElementById('RecoverPassword');
      var l = document.getElementById('CustomerLogin');
      r.hidden = !r.hidden;
      l.hidden = !r.hidden ? true : false;
    });
  });
  if (window.location.hash === '#recover') {
    document.getElementById('RecoverPassword').hidden = false;
    document.getElementById('CustomerLogin').hidden = true;
  }
</script>
