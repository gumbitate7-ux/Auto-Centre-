{%- assign contact_email = settings.contact_email | default: shop.email -%}
<section class="section" aria-labelledby="ContactTitle-{{ section.id }}">
  <div class="container">
    <div class="contact-grid">
      <div class="stack-lg">
        <div class="stack">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="h2" id="ContactTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
        </div>
        <ul class="contact-cards" role="list">
          {%- if contact_email != blank -%}
            <li class="contact-card">
              <span class="contact-card__icon">{% render 'icon', name: 'mail' %}</span>
              <span><span class="contact-card__label">{{ 'contact.email' | t }}</span><br><span class="contact-card__value"><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></span></span>
            </li>
          {%- endif -%}
          {%- if settings.contact_phone != blank -%}
            <li class="contact-card">
              <span class="contact-card__icon">{% render 'icon', name: 'phone' %}</span>
              <span><span class="contact-card__label">{{ 'contact.phone' | t }}</span><br><span class="contact-card__value"><a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a></span></span>
            </li>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <li class="contact-card">
              <span class="contact-card__icon">{% render 'icon', name: 'clock' %}</span>
              <span><span class="contact-card__label">{{ 'contact.hours' | t }}</span><br><span class="contact-card__value">{{ settings.contact_hours | escape }}</span></span>
            </li>
          {%- endif -%}
          {%- if settings.contact_location != blank -%}
            <li class="contact-card">
              <span class="contact-card__icon">{% render 'icon', name: 'pin' %}</span>
              <span><span class="contact-card__label">{{ 'contact.location' | t }}</span><br><span class="contact-card__value">{{ settings.contact_location | escape }}</span></span>
            </li>
          {%- endif -%}
        </ul>
        {%- render 'delivery-note' -%}
      </div>

      {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
      {%- form 'contact', id: contact_form_id, class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check-circle' %}<span>{{ 'contact.success' | t }}</span></div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">
            {%- render 'icon', name: 'alert' -%}
            <span>{{ form.errors | default_errors }}</span>
          </div>
        {%- endif -%}
        <h3 class="h3">{{ section.settings.form_heading | escape }}</h3>
        <div class="contact-form__row">
          <div class="field">
            <label class="field__label" for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
            <input class="input" type="text" id="ContactName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </div>
          <div class="field">
            <label class="field__label" for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="input" type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" autocomplete="email" autocapitalize="off" value="{{ form.email }}" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          </div>
        </div>
        <div class="contact-form__row">
          <div class="field">
            <label class="field__label" for="ContactPhone-{{ section.id }}">{{ 'contact.phone_optional' | t }}</label>
            <input class="input" type="tel" id="ContactPhone-{{ section.id }}" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactOrder-{{ section.id }}">{{ 'contact.order_number' | t }}</label>
            <input class="input" type="text" id="ContactOrder-{{ section.id }}" name="contact[order_number]" placeholder="#1001">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="ContactTopic-{{ section.id }}">{{ 'contact.topic' | t }}</label>
          <select class="select" id="ContactTopic-{{ section.id }}" name="contact[topic]">
            <option>{{ 'contact.topic_product' | t }}</option>
            <option>{{ 'contact.topic_order' | t }}</option>
            <option>{{ 'contact.topic_delivery' | t }}</option>
            <option>{{ 'contact.topic_returns' | t }}</option>
            <option>{{ 'contact.topic_other' | t }}</option>
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
          <textarea class="textarea" id="ContactBody-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--primary">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow-right' %}</button>
        <p class="text-small text-muted">{{ section.settings.response_note | escape }}</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We’re here to help." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a product, your order or delivery? Send us a message and our team will get back to you." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a message" },
    { "type": "text", "id": "response_note", "label": "Response note", "default": "We aim to reply within 1–2 business days." },
    { "type": "paragraph", "content": "Email, phone, hours and location are edited in Theme settings → Contact & social. Messages are sent to the store's sender email set in Shopify Admin → Settings → Notifications." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
