{%- liquid
  assign featured = all_products['wallet-tracker-card-2-pack']
  if featured.id == blank
    assign featured = collections.all.products.first
  endif
-%}
<section class="section">
  <div class="container container--narrow" data-cart-page>
    <h1 class="h2 page-title">Your cart</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page" id="CartForm">
        <div class="cart-page__items">
          {% render 'cart-items', context: 'page' %}
          <noscript>
            <button type="submit" name="update" class="btn btn--secondary">Update cart</button>
          </noscript>
        </div>

        <aside class="cart-page__summary card">
          {%- if settings.show_cart_note -%}
            <label for="CartNote" class="field__label">Order note</label>
            <textarea id="CartNote" name="note" class="field__input" rows="3" placeholder="Anything we should know?">{{ cart.note }}</textarea>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-totals__row">
              <span>{{ discount.title }}</span>
              <span>&minus;{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-totals__row">
            <span>Delivery ({{ settings.courier_name }})</span>
            <span>{% if settings.free_shipping %}Free{% else %}At checkout{% endif %}</span>
          </div>
          <div class="cart-totals__row cart-totals__row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>
          {%- if settings.company_vat_no != blank -%}
            <p class="cart-totals__note">VAT included.</p>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">
            {% render 'icon', name: 'lock', size: 18 %}
            <span>Secure checkout</span>
          </button>
          {% render 'guarantee-list' %}
          {% render 'payment-icons' %}
        </aside>
      </form>
    {%- else -%}
      <div class="cart-empty cart-empty--page">
        <span class="cart-empty__icon">{% render 'icon', name: 'bag', size: 36 %}</span>
        <p class="cart-empty__title">Your cart is empty</p>
        <p class="muted">Two tracker cards, free delivery, one less thing to worry about.</p>
        {%- if featured.id != blank -%}
          <a href="{{ featured.url }}" class="btn btn--primary">Shop the 2-pack &mdash; {{ featured.price | money_without_trailing_zeros }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue shopping</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
