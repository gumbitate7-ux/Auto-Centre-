{%- comment -%}
  Accepts: product
{%- endcomment -%}
<a href="{{ product.url }}" class="product-card card">
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {%- assign card_alt = product.featured_media.alt | default: product.title -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 990px) 360px, (min-width: 750px) 45vw, 90vw',
          alt: card_alt
      }}
    {%- else -%}
      <img src="{{ 'tracker-card-find-anywhere.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="851" height="851" loading="lazy">
    {%- endif -%}
  </div>
  <div class="product-card__info">
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product %}
    {%- unless product.available -%}<span class="badge">Sold out</span>{%- endunless -%}
  </div>
</a>
