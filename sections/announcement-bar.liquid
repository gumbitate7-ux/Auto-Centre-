{%- if section.blocks.size > 0 -%}
  <div class="announcement announcement--{{ section.settings.style }}" data-announcement>
    <div class="container announcement__inner">
      <div class="announcement__track" aria-live="polite">
        {%- for block in section.blocks -%}
          <p class="announcement__message{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              {% render 'icon', name: block.settings.icon, size: 16 %}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" },
        { "value": "soft", "label": "Soft" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Aramex delivery across South Africa"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Clock" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Warranty" },
            { "value": "lock", "label": "Secure" },
            { "value": "chat", "label": "Chat" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
