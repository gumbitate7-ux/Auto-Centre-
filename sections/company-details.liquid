{%- comment -%}
  "Who you're buying from": the business disclosures required by section 43 of the ECT Act,
  pulled from Theme settings → Business details.
{%- endcomment -%}
<section class="section company section--{{ section.settings.background }}">
  <div class="container container--narrow">
    <header class="section-head section-head--center">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <dl class="company__list card">
      <div class="company__row">
        <dt>Business name</dt>
        <dd>{{ settings.company_legal_name | default: shop.name }}</dd>
      </div>
      {%- if settings.company_reg_no != blank -%}
        <div class="company__row">
          <dt>Registration number</dt>
          <dd>{{ settings.company_reg_no }}</dd>
        </div>
      {%- endif -%}
      {%- if settings.company_vat_no != blank -%}
        <div class="company__row">
          <dt>VAT number</dt>
          <dd>{{ settings.company_vat_no }}</dd>
        </div>
      {%- endif -%}
      {%- if settings.company_address != blank -%}
        <div class="company__row">
          <dt>Physical address</dt>
          <dd>{{ settings.company_address | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}
      {%- if settings.support_email != blank -%}
        <div class="company__row">
          <dt>Email</dt>
          <dd><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></dd>
        </div>
      {%- endif -%}
      {%- if settings.support_phone != blank -%}
        <div class="company__row">
          <dt>Phone</dt>
          <dd><a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone }}</a></dd>
        </div>
      {%- endif -%}
      <div class="company__row">
        <dt>Payments</dt>
        <dd>Processed securely by Yoco. We never see or store your card details.</dd>
      </div>
      <div class="company__row">
        <dt>Delivery partner</dt>
        <dd>{{ settings.courier_name }}, with tracking on every order</dd>
      </div>
    </dl>
    {%- if request.design_mode and settings.company_reg_no == blank -%}
      <p class="notice">Add your registration number and physical address in Theme settings → Business details.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Business details",
  "class": "section-company",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who you're buying from" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're a registered South African business. Here are our details, as the ECT Act requires.</p>" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Business details" }]
}
{% endschema %}
