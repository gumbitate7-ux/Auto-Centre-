<section class="section">
  <div class="container">
    <div class="account-head">
      <div>
        <h1 class="h2">Hi {{ customer.first_name | default: 'there' }}</h1>
        <p class="muted">{{ customer.email }}</p>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--secondary">Sign out</a>
    </div>
    <div class="account-grid">
      <div>
        <h2 class="h4">Your orders</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr><th>Order</th><th>Date</th><th>Payment</th><th>Delivery</th><th>Total</th></tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ order.created_at | date: '%e %b %Y' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_price | money_without_trailing_zeros }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p class="muted">You haven't placed any orders yet.</p>
          {%- endif -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </div>
      <aside class="card">
        <h2 class="h4">Default address</h2>
        {%- if customer.default_address -%}
          <p>{{ customer.default_address | format_address }}</p>
        {%- else -%}
          <p class="muted">No address saved.</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="link-arrow">Manage addresses ({{ customer.addresses_count }})</a>
      </aside>
    </div>
  </div>
</section>
