{%- liquid
  assign featured = all_products['wallet-tracker-card-2-pack']
  if featured.id == blank
    assign featured = collections.all.products.first
  endif
  if featured.id != blank
    assign shop_url = featured.url
  else
    assign shop_url = routes.all_products_collection_url
  endif
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div class="site-footer__col site-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <a href="{{ routes.root_url }}" class="logo logo--footer">{% render 'logo', inverse: true %}</a>
              {%- if block.settings.text != blank -%}
                <div class="site-footer__about">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank -%}
                <ul class="social-links" role="list">
                  {%- if settings.social_instagram != blank -%}
                    <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 20 %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_facebook != blank -%}
                    <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 20 %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_tiktok != blank -%}
                    <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 20 %}</a></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

            {%- when 'menu' -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              <ul class="site-footer__links" role="list">
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- case block.settings.fallback -%}
                    {%- when 'shop' -%}
                      <li><a href="{{ shop_url }}">Tracker Card 2-Pack</a></li>
                      <li><a href="{{ routes.root_url }}#how-it-works">How it works</a></li>
                      <li><a href="/pages/about">About us</a></li>
                      <li><a href="/pages/contact">Contact</a></li>
                    {%- when 'help' -%}
                      <li><a href="/pages/faq">FAQ</a></li>
                      <li><a href="/pages/track-order">Track your order</a></li>
                      <li><a href="/pages/shipping">Shipping &amp; delivery</a></li>
                      <li><a href="/pages/returns">Returns &amp; warranty</a></li>
                    {%- when 'legal' -%}
                      {%- for policy in shop.policies -%}
                        <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                      {%- else -%}
                        <li><a href="/policies/refund-policy">Refund policy</a></li>
                        <li><a href="/policies/privacy-policy">Privacy policy</a></li>
                        <li><a href="/policies/terms-of-service">Terms of service</a></li>
                        <li><a href="/policies/shipping-policy">Shipping policy</a></li>
                      {%- endfor -%}
                  {%- endcase -%}
                {%- endif -%}
              </ul>

            {%- when 'contact' -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              <ul class="site-footer__contact" role="list">
                {%- if wa_number != blank -%}
                  <li>
                    <a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">
                      {% render 'icon', name: 'whatsapp', size: 18 %} WhatsApp us
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.support_email != blank -%}
                  <li><a href="mailto:{{ settings.support_email }}">{% render 'icon', name: 'mail', size: 18 %} {{ settings.support_email }}</a></li>
                {%- endif -%}
                {%- if settings.support_phone != blank -%}
                  <li><a href="tel:{{ settings.support_phone | remove: ' ' }}">{% render 'icon', name: 'phone', size: 18 %} {{ settings.support_phone }}</a></li>
                {%- endif -%}
                {%- if settings.support_hours != blank -%}
                  <li class="site-footer__hours">{% render 'icon', name: 'clock', size: 18 %} <span>{{ settings.support_hours }}</span></li>
                {%- endif -%}
              </ul>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__trust">
      <div class="site-footer__trust-item">
        {% render 'icon', name: 'lock', size: 18 %}
        <span>Secure checkout &middot; card payments processed by Yoco</span>
      </div>
      <div class="site-footer__trust-item">
        {% render 'icon', name: 'truck', size: 18 %}
        <span>Tracked delivery with {{ settings.courier_name }}</span>
      </div>
      {% render 'payment-icons' %}
    </div>

    <div class="site-footer__legal">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ settings.company_legal_name | default: shop.name }}
        {%- if settings.company_reg_no != blank %} &middot; Reg. no. {{ settings.company_reg_no }}{% endif -%}
        {%- if settings.company_vat_no != blank %} &middot; VAT no. {{ settings.company_vat_no }}{% endif -%}
      </p>
      {%- if settings.company_address != blank -%}
        <p>{{ settings.company_address | escape | newline_to_br | replace: '<br />', ', ' | strip_newlines }}</p>
      {%- endif -%}
      <p>Prices in South African Rand{% if settings.company_vat_no != blank %}, including VAT{% endif %}.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "About text",
          "default": "<p>A small South African team making it harder to lose the things you carry every day.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Leave empty to use the built-in links below."
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Built-in links",
          "options": [
            { "value": "shop", "label": "Shop" },
            { "value": "help", "label": "Help" },
            { "value": "legal", "label": "Policies" }
          ],
          "default": "help"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact details",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Talk to us"
        },
        {
          "type": "paragraph",
          "content": "Contact details come from Theme settings → Business details."
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
