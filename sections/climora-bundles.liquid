{%- comment -%}
  Curated sets. No discount is implied: the total shown is the live sum of the
  selected variants' Shopify prices. Customers choose sizes/colours per item and
  add the whole set to the cart in one action (Cart AJAX API, items[]).
{%- endcomment -%}
<section class="section {{ section.settings.background }}" aria-labelledby="BundlesTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2" id="BundlesTitle-{{ section.id }}" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-head__text" data-reveal>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="bundles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign products = block.settings.products
          assign dark = false
          if block.settings.style == 'dark'
            assign dark = true
          endif
          assign total = 0
          assign all_available = true
          assign product_count = products.size | default: 0
          assign fallback_kinds = block.settings.placeholder_art | split: ','
        -%}
        <form
          action="{{ routes.cart_add_url }}"
          method="post"
          class="bundle{% if dark %} bundle--dark{% endif %}"
          data-bundle
          data-reveal
          style="--reveal-delay: {{ forloop.index0 | times: 120 }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="bundle__visual" aria-hidden="true">
            {%- if product_count > 0 -%}
              {%- for product in products -%}
                <span class="bundle__thumb">
                  {%- if product.featured_media -%}
                    {{ product.featured_media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', widths: '160, 240, 320', sizes: '140px' }}
                  {%- else -%}
                    {%- render 'climora-art', product: product -%}
                  {%- endif -%}
                </span>
                {%- unless forloop.last -%}<span class="bundle__plus">{% render 'icon', name: 'plus' %}</span>{%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              {%- for kind in fallback_kinds -%}
                {%- assign art_kind = kind | strip -%}
                <span class="bundle__thumb">{% render 'climora-art', kind: art_kind %}</span>
                {%- unless forloop.last -%}<span class="bundle__plus">{% render 'icon', name: 'plus' %}</span>{%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="bundle__body">
            <div class="stack">
              {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
              <h3 class="bundle__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="text-muted">{{ block.settings.text | escape }}</p>{%- endif -%}
            </div>

            {%- if product_count > 0 -%}
              <ul class="bundle__items" role="list">
                {%- for product in products -%}
                  {%- liquid
                    assign v = product.selected_or_first_available_variant
                    assign total = total | plus: v.price
                    unless product.available
                      assign all_available = false
                    endunless
                    assign idx = forloop.index0
                  -%}
                  <li class="bundle__item">
                    <span class="bundle__item-name"><a href="{{ product.url }}">{{ product.title | escape }}</a></span>
                    <span class="price" data-bundle-line-price>{{ v.price | money }}</span>
                    {%- if product.has_only_default_variant -%}
                      <input type="hidden" name="items[{{ idx }}][id]" value="{{ v.id }}" data-bundle-variant data-price="{{ v.price }}">
                    {%- else -%}
                      <label class="visually-hidden" for="Bundle-{{ section.id }}-{{ block.id }}-{{ idx }}">{{ 'bundles.choose_option' | t: title: product.title | escape }}</label>
                      <select class="select" id="Bundle-{{ section.id }}-{{ block.id }}-{{ idx }}" name="items[{{ idx }}][id]" data-bundle-variant>
                        {%- for variant in product.variants -%}
                          <option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                            {{ variant.title | escape }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                          </option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                    <input type="hidden" name="items[{{ idx }}][quantity]" value="1">
                  </li>
                {%- endfor -%}
              </ul>

              <div class="bundle__foot">
                <div class="bundle__total">
                  <span class="bundle__total-label">{{ 'bundles.combined_price' | t }}</span>
                  <span class="price price--lg" data-bundle-total>{{ total | money }}</span>
                </div>
                <p class="bundle__note">{{ 'bundles.note' | t }}</p>
                {%- if all_available -%}
                  <button type="submit" class="btn btn--primary btn--block" data-add-button>{% render 'icon', name: 'cart' %}<span>{{ block.settings.button_label | escape }}</span></button>
                {%- else -%}
                  <button type="button" class="btn btn--primary btn--block" disabled>{{ 'bundles.unavailable' | t }}</button>
                {%- endif -%}
                <div class="form-message form-message--error buy__error" role="alert" data-form-error>{% render 'icon', name: 'alert' %}<span data-form-error-text></span></div>
              </div>
            {%- else -%}
              <ul class="bundle__items" role="list">
                {%- assign names = block.settings.placeholder_items | split: ',' -%}
                {%- for name in names -%}<li class="bundle__item"><span class="bundle__item-name">{{ name | strip | escape }}</span></li>{%- endfor -%}
              </ul>
              <div class="bundle__foot">
                <a class="btn btn--primary btn--block" href="{{ block.settings.fallback_link | default: routes.all_products_collection_url }}">{{ 'bundles.shop_items' | t }}</a>
                {%- if request.design_mode -%}<p class="bundle__note">{{ 'bundles.editor_hint' | t }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </form>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curated sets",
  "tag": "div",
  "class": "section-bundles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better together." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Complementary combinations, selected to make choosing simple. Pick your sizes and add the whole set in one step." },
    { "type": "select", "id": "background", "label": "Background", "default": "", "options": [{ "value": "", "label": "White" }, { "value": "section--mist", "label": "Mist" }, { "value": "section--ice", "label": "Ice gradient" }] }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Set",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "style", "label": "Style", "default": "light", "options": [{ "value": "light", "label": "Ice" }, { "value": "dark", "label": "Midnight" }] },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Set" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Ultimate Sleep Set" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add set to cart" },
        { "type": "header", "content": "Before products are assigned" },
        { "type": "text", "id": "placeholder_items", "label": "Item names (comma separated)", "default": "CLIMORA FrostLayer, CLIMORA IceSoft" },
        { "type": "text", "id": "placeholder_art", "label": "Illustrations (comma separated)", "default": "topper, pillow", "info": "Options: fan, pillow, topper" },
        { "type": "url", "id": "fallback_link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated sets",
      "blocks": [
        { "type": "bundle", "settings": { "style": "light", "eyebrow": "SleepTech set", "title": "The Ultimate Sleep Set", "text": "FrostLayer and IceSoft together — a complete cooling-feel upgrade for your bed.", "placeholder_items": "CLIMORA FrostLayer, CLIMORA IceSoft", "placeholder_art": "topper, pillow" } },
        { "type": "bundle", "settings": { "style": "dark", "eyebrow": "Day + night set", "title": "The Everyday Cooling Set", "text": "SolarFlow for warmer days, plus FrostLayer and IceSoft for warmer nights.", "placeholder_items": "CLIMORA SolarFlow, CLIMORA FrostLayer, CLIMORA IceSoft", "placeholder_art": "fan, topper, pillow" } }
      ]
    }
  ]
}
{% endschema %}
