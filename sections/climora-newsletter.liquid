{%- assign dark = false -%}
{%- if section.settings.style == 'dark' -%}{%- assign dark = true -%}{%- endif -%}
<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}" aria-labelledby="NewsletterTitle-{{ section.id }}">
  <div class="container">
    <div class="newsletter{% if dark %} newsletter--dark on-dark{% endif %}" data-reveal>
      <div class="stack">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2" id="NewsletterTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- assign newsletter_form_id = 'Newsletter-' | append: section.id -%}
      {%- form 'customer', id: newsletter_form_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check-circle' %}<span>{{ 'newsletter.success' | t }}</span></div>
        {%- else -%}
          <div class="newsletter__row">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
            >
            <button type="submit" class="btn {% if dark %}btn--light{% else %}btn--primary{% endif %}">{{ section.settings.button_label | escape }}</button>
          </div>
          {%- if form.errors -%}
            <div class="form-message form-message--error" id="NewsletterError-{{ section.id }}" role="alert">{% render 'icon', name: 'alert' %}<span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span></div>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.fine_print != blank -%}<p class="newsletter__fine">{{ section.settings.fine_print | escape }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "section-newsletter",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "light", "options": [{ "value": "light", "label": "Ice" }, { "value": "dark", "label": "Midnight" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooler ideas, delivered." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be the first to hear about new CLIMORA products, restocks and practical tips for staying comfortable in the heat." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "You can unsubscribe at any time. We respect your privacy." },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": false }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
