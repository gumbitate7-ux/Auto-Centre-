<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_navy | default: '#182A40' }}">
    {%- render 'meta-tags' -%}
    {%- if settings.load_google_fonts -%}
      {{ 'sora-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'manrope-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      <style>
        @font-face { font-family: "Sora"; font-style: normal; font-weight: 400 600; font-display: swap; src: url("{{ 'sora-latin.woff2' | asset_url }}") format("woff2"); }
        @font-face { font-family: "Manrope"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("{{ 'manrope-latin.woff2' | asset_url }}") format("woff2"); }
      </style>
    {%- endif -%}
    {{ 'climora.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
