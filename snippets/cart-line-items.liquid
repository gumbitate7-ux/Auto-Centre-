{%- comment -%}
  Cart line items, shared by the cart drawer and the cart page.
  Quantity changes and removals use the native Cart AJAX API (see climora.js),
  with links/inputs that still work without JavaScript.
  Accepts: context ('drawer' | 'page')
{%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-cart-item data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '120, 240, 300', sizes: '120px' }}
        {%- else -%}
          {%- render 'climora-art', product: item.product -%}
        {%- endif -%}
      </a>
      <div class="cart-item__info">
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}
              {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}
        <div class="cart-item__row">
          <div class="qty qty--sm" data-qty>
            <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
            <input
              class="qty__input"
              type="number"
              name="updates[]"
              id="CartQty-{{ context }}-{{ forloop.index }}"
              value="{{ item.quantity }}"
              min="0"
              {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}max="{{ item.variant.inventory_quantity }}"{% endif %}
              inputmode="numeric"
              aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}"
              data-line-quantity
            >
            <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
          </div>
          <div class="cart-item__price">
            {%- if item.original_line_price != item.final_line_price -%}
              <s class="price__compare">{{ item.original_line_price | money }}</s>
            {%- endif -%}
            {{ item.final_line_price | money }}
          </div>
        </div>
        <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-line-remove>{{ 'cart.remove' | t }}<span class="visually-hidden"> {{ item.product.title | escape }}</span></a>
      </div>
    </li>
  {%- endfor -%}
</ul>
