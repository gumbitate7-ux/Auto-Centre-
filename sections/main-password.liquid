<section class="hero hero--dark on-dark" style="min-height:100vh;display:grid;align-items:center">
  <div class="container container--narrow" style="padding-block:var(--section-y)">
    <div class="stack-lg" style="text-align:center;justify-items:center">
      <span class="wordmark">{% render 'climora-art', kind: 'mark' %}<span>CLIMORA</span></span>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="h-display">{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}<p class="hero__text">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter__form', style: 'width:100%;max-width:520px' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success" role="status">{% render 'icon', name: 'check-circle' %}<span>{{ 'newsletter.success' | t }}</span></div>
        {%- else -%}
          <div class="newsletter__row">
            <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
            <input id="PasswordNewsletter" class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required style="background:rgba(255,255,255,.06);color:#fff;border-color:var(--c-dark-line)">
            <button class="btn btn--light" type="submit">{{ 'password.notify' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
      <details style="width:100%;max-width:520px">
        <summary class="text-small" style="cursor:pointer;color:var(--c-dark-muted)">{{ 'password.owner' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter__form', style: 'margin-top:16px' -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="newsletter__row">
            <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
            <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" style="background:rgba(255,255,255,.06);color:#fff;border-color:var(--c-dark-line)">
            <button class="btn btn--ghost-light" type="submit">{{ 'password.enter' | t }}</button>
          </div>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Launching soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The future of staying cool." }
  ]
}
{% endschema %}
