<section
  class="section features features--{{ section.settings.style }} section--{{ section.settings.background }}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <header class="section-head{% if section.settings.center %} section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="section-head__text">{{ section.settings.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="features__grid features__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: block.settings.icon, size: 24 %}</span>
          <h3 class="feature__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="feature__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="features__note">{% render 'icon', name: 'info', size: 18 %} <span>{{ section.settings.note }}</span></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "class": "section-features",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small card. Big relief." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "center", "label": "Centre heading", "default": true },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "cards", "label": "Cards" },
        { "value": "plain", "label": "Plain" }
      ],
      "default": "cards"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "note", "label": "Footnote" },
    { "type": "text", "id": "anchor", "label": "Anchor ID" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sound", "label": "Sound" },
            { "value": "bell", "label": "Bell" },
            { "value": "pin", "label": "Pin" },
            { "value": "map", "label": "Map" },
            { "value": "card", "label": "Card" },
            { "value": "thin", "label": "Thin" },
            { "value": "lock", "label": "Lock" },
            { "value": "eye-off", "label": "Privacy" },
            { "value": "battery", "label": "Battery" },
            { "value": "power", "label": "Power" },
            { "value": "signal", "label": "Signal" },
            { "value": "wallet", "label": "Wallet" },
            { "value": "luggage", "label": "Luggage" },
            { "value": "briefcase", "label": "Laptop bag" },
            { "value": "passport", "label": "Passport" },
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Clock" },
            { "value": "package", "label": "Package" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Warranty" },
            { "value": "chat", "label": "Support" },
            { "value": "check-circle", "label": "Check" },
            { "value": "tool", "label": "Tested" },
            { "value": "home", "label": "Home" },
            { "value": "gift", "label": "Gift" },
            { "value": "smile", "label": "Smile" }
          ],
          "default": "sound"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the feature.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
