{%- comment -%}
  Slide-out cart. Rendered statically from layout/theme.liquid and refreshed through
  the Section Rendering API (sections=climora-cart-drawer) after every cart change.
{%- endcomment -%}
<div id="CartDrawer" class="drawer" data-cart-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__inner" data-cart-drawer-inner data-cart-count="{{ cart.item_count }}" style="display:contents">
      <div class="drawer__head">
        <h2 class="drawer__title" id="CartDrawerTitle">
          {{ 'cart.title' | t }}
          {%- if cart.item_count > 0 %} <span class="text-muted">({{ cart.item_count }})</span>{% endif -%}
        </h2>
        <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>

      <div class="drawer__body">
        <div class="form-message form-message--error cart-error" role="alert" data-cart-error hidden>
          {%- render 'icon', name: 'alert' -%}<span data-cart-error-text></span>
        </div>
        {%- if cart.item_count > 0 -%}
          {%- render 'cart-line-items', context: 'drawer' -%}
        {%- else -%}
          <div class="cart-empty">
            <div class="cart-empty__icon">{% render 'icon', name: 'cart' %}</div>
            <div class="stack">
              <p class="h4">{{ 'cart.empty_title' | t }}</p>
              <p class="text-muted">{{ 'cart.empty_text' | t }}</p>
            </div>
            <div class="stack" style="width:100%">
              <a class="btn btn--primary btn--block" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_all' | t }}</a>
              <div class="cluster" style="justify-content:center">
                <a class="chip" href="{{ routes.collections_url }}/sleep-cooling">{% render 'icon', name: 'moon' %} {{ 'cart.sleep_cooling' | t }}</a>
                <a class="chip" href="{{ routes.collections_url }}/portable-cooling">{% render 'icon', name: 'fan' %} {{ 'cart.portable_cooling' | t }}</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="drawer__foot">
          <form action="{{ routes.cart_url }}" method="post" class="cart-summary" novalidate>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row text-small">
                  <span>{{ discount.title | escape }}</span>
                  <span>−{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
            <div class="cart-summary__row">
              <span class="h4">{{ 'cart.subtotal' | t }}</span>
              <span class="cart-summary__total">{{ cart.total_price | money_with_currency }}</span>
            </div>
            <p class="cart-summary__fine">{{ 'cart.taxes_shipping_checkout' | t }}</p>
            {%- render 'delivery-note', compact: true -%}
            <button type="submit" name="checkout" class="btn btn--primary btn--block">
              {%- render 'icon', name: 'lock' -%}<span>{{ 'cart.checkout' | t }}</span>
            </button>
            <a class="btn btn--secondary btn--block" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
            <p class="secure-line">{% render 'icon', name: 'shield' %} {{ 'cart.secure_checkout' | t }}</p>
          </form>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
