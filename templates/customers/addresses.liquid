<section class="section">
  <div class="container container--narrow">
    <a href="{{ routes.account_url }}" class="link-arrow">{% render 'icon', name: 'chevron-left', size: 16 %} Back to your account</a>
    <h1 class="h2">Your addresses</h1>

    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="card address-card">
          {%- if address == customer.default_address -%}<span class="badge">Default</span>{%- endif -%}
          <p>{{ address | format_address }}</p>
          <details>
            <summary class="link-arrow">Edit</summary>
            {%- form 'customer_address', address -%}
              {% render 'address-fields', form: form, prefix: address.id %}
              <div class="button-row">
                <button type="submit" class="btn btn--primary">Save</button>
              </div>
            {%- endform -%}
          </details>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" onsubmit="return confirm('Delete this address?');">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="btn btn--ghost btn--small">Delete</button>
          </form>
        </div>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}

    <details class="card">
      <summary class="h4">Add a new address</summary>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-fields', form: form, prefix: 'new' %}
        <button type="submit" class="btn btn--primary">Add address</button>
      {%- endform -%}
    </details>
  </div>
</section>
