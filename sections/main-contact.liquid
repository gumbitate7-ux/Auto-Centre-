{%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
<section class="section contact">
  <div class="container">
    <header class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="section-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="contact__grid">
      <div class="contact__channels">
        {%- if wa_number != blank -%}
          <a class="contact-card card" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
            <span class="contact-card__icon contact-card__icon--wa">{% render 'icon', name: 'whatsapp', size: 24 %}</span>
            <span>
              <strong>WhatsApp</strong>
              <small>Fastest way to reach us</small>
            </span>
            {% render 'icon', name: 'chevron-right', size: 18 %}
          </a>
        {%- endif -%}
        {%- if settings.support_email != blank -%}
          <a class="contact-card card" href="mailto:{{ settings.support_email }}">
            <span class="contact-card__icon">{% render 'icon', name: 'mail', size: 24 %}</span>
            <span>
              <strong>Email</strong>
              <small>{{ settings.support_email }}</small>
            </span>
            {% render 'icon', name: 'chevron-right', size: 18 %}
          </a>
        {%- endif -%}
        {%- if settings.support_phone != blank -%}
          <a class="contact-card card" href="tel:{{ settings.support_phone | remove: ' ' }}">
            <span class="contact-card__icon">{% render 'icon', name: 'phone', size: 24 %}</span>
            <span>
              <strong>Phone</strong>
              <small>{{ settings.support_phone }}</small>
            </span>
            {% render 'icon', name: 'chevron-right', size: 18 %}
          </a>
        {%- endif -%}
        <div class="contact-card contact-card--static card">
          <span class="contact-card__icon">{% render 'icon', name: 'clock', size: 24 %}</span>
          <span>
            <strong>Hours</strong>
            <small>{{ settings.support_hours }}</small>
          </span>
        </div>
        <p class="contact__promise">{% render 'icon', name: 'check-circle', size: 18 %} <span>{{ settings.response_time }}</span></p>
        <a class="link-arrow" href="/pages/track-order">Looking for your parcel? Track your order {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </div>

      <div class="contact__form card">
        <h2 class="h3">Send us a message</h2>
        {%- form 'contact', id: 'ContactForm', class: 'form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">
              {% render 'icon', name: 'check-circle', size: 18 %}
              Thanks! Your message is with us. We'll get back to you soon.
            </p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form__row">
            <div class="field">
              <label class="field__label" for="ContactName">Name</label>
              <input class="field__input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail">Email</label>
              <input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
            </div>
          </div>
          <div class="form__row">
            <div class="field">
              <label class="field__label" for="ContactPhone">Phone <span class="muted">(optional)</span></label>
              <input class="field__input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label class="field__label" for="ContactOrder">Order number <span class="muted">(if you have one)</span></label>
              <input class="field__input" id="ContactOrder" type="text" name="contact[order_number]" placeholder="#1001">
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="ContactTopic">What's it about?</label>
            <select class="field__input" id="ContactTopic" name="contact[topic]">
              <option>A question before I buy</option>
              <option>Where is my order?</option>
              <option>Help setting up my card</option>
              <option>Return or refund</option>
              <option>Warranty / faulty card</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="ContactBody">Message</label>
            <textarea class="field__input" id="ContactBody" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--lg">Send message</button>
          <p class="form__fine">We only use your details to reply to you. See our <a href="/policies/privacy-policy">privacy policy</a>.</p>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions before you buy, help with setup, or something not right with your order? Message us. A real person on our team will answer, not a bot.</p>"
    }
  ]
}
{% endschema %}
