<section class="section">
  <div class="container container--narrow account-form">
    <h1 class="h2">Reset your password</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ResetPassword">New password</label>
        <input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">Confirm new password</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary">Reset password</button>
    {%- endform -%}
  </div>
</section>
