{%- comment -%}
  The people behind the store. Each card shows a role; add real names and photos when ready.
  Cards without a photo show an icon, so nothing looks unfinished in the meantime.
{%- endcomment -%}
<section class="section team section--{{ section.settings.background }}">
  <div class="container">
    <header class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <div class="team__grid">
      {%- for block in section.blocks -%}
        <article class="team-card card" {{ block.shopify_attributes }}>
          <div class="team-card__photo">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, width: 160, height: 160 }}
            {%- else -%}
              <span class="team-card__icon">{% render 'icon', name: block.settings.icon, size: 30 %}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.name != blank -%}
            <h3 class="team-card__name">{{ block.settings.name }}</h3>
            <p class="team-card__role">{{ block.settings.role }}</p>
          {%- else -%}
            <h3 class="team-card__name">{{ block.settings.role }}</h3>
          {%- endif -%}
          {%- if block.settings.bio != blank -%}
            <div class="team-card__bio">{{ block.settings.bio }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team",
  "class": "section-team",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real people, right here in South Africa" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "info": "Use a real name (first name is fine). Leave empty to show the role only." },
        { "type": "text", "id": "role", "label": "Role", "default": "Customer care" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (when no photo)",
          "options": [
            { "value": "chat", "label": "Support" },
            { "value": "package", "label": "Packing" },
            { "value": "tool", "label": "Testing" },
            { "value": "home", "label": "Founder" },
            { "value": "truck", "label": "Delivery" },
            { "value": "smile", "label": "Smile" }
          ],
          "default": "chat"
        },
        { "type": "richtext", "id": "bio", "label": "Short bio" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team",
      "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }]
    }
  ]
}
{% endschema %}
