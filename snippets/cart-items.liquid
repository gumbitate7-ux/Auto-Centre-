{%- comment -%}
  Line items shared by the cart drawer and the cart page.
  Accepts: context ('drawer' or 'page')
{%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title, width: 100, height: 100 }}
        {%- else -%}
          <img src="{{ 'tracker-card-find-anywhere.jpg' | asset_url }}" alt="" width="100" height="100" loading="lazy">
        {%- endif -%}
      </a>
      <div class="cart-item__info">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- unless property.last == blank or property.first contains '_' -%}
            <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        <div class="cart-item__row">
          <div class="qty qty--small">
            <button type="button" class="qty__btn" aria-label="Decrease quantity of {{ item.product.title | escape }}" data-cart-qty="{{ item.quantity | minus: 1 }}" data-cart-line="{{ forloop.index }}">
              {% render 'icon', name: 'minus', size: 16 %}
            </button>
            {%- if context == 'page' -%}
              <input class="qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity of {{ item.product.title | escape }}" data-cart-input data-cart-line="{{ forloop.index }}">
            {%- else -%}
              <span class="qty__value" aria-live="polite">{{ item.quantity }}</span>
            {%- endif -%}
            <button type="button" class="qty__btn" aria-label="Increase quantity of {{ item.product.title | escape }}" data-cart-qty="{{ item.quantity | plus: 1 }}" data-cart-line="{{ forloop.index }}">
              {% render 'icon', name: 'plus', size: 16 %}
            </button>
          </div>
          <div class="cart-item__price">
            {%- if item.original_line_price > item.final_line_price -%}
              <s class="price__compare">{{ item.original_line_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
            <span>{{ item.final_line_price | money_without_trailing_zeros }}</span>
          </div>
        </div>
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (&minus;{{ discount.amount | money_without_trailing_zeros }})</p>
        {%- endfor -%}
        <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-cart-qty="0" data-cart-line="{{ forloop.index }}">Remove</a>
      </div>
    </li>
  {%- endfor -%}
</ul>
