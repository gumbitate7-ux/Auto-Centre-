<section class="section {{ section.settings.background }}" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="container">
    <div class="faq-layout">
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2" id="FaqTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div><a class="btn {% if section.settings.background == 'section--dark' %}btn--ghost-light{% else %}btn--secondary{% endif %}" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
      <div class="accordion" data-accordion-group>
        {%- for block in section.blocks -%}
          <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary class="accordion__summary">
              <span>{{ block.settings.question | escape }}</span>
              <span class="accordion__icon" aria-hidden="true"></span>
            </summary>
            <div class="accordion__content"><div class="rte">{{ block.settings.answer }}</div></div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Everything you need to know before you order. Can’t find your answer? Get in touch." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "", "options": [{ "value": "", "label": "White" }, { "value": "section--mist", "label": "Mist" }, { "value": "section--ice", "label": "Ice gradient" }, { "value": "section--dark", "label": "Midnight" }] }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Your CLIMORA order will be delivered through our courier partner, Aramex. Estimated delivery is 5–10 business days, subject to order processing and courier collection.</p>" } },
        { "type": "question", "settings": { "question": "How will I know when my order has shipped?", "answer": "<p>Once your order has been handed to Aramex, you’ll receive a shipping confirmation email. When tracking is available for your shipment, the tracking details are included in that email.</p>" } },
        { "type": "question", "settings": { "question": "Is checkout secure?", "answer": "<p>Yes. Payments are processed through Shopify’s encrypted checkout. Available payment methods are shown at checkout.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a product?", "answer": "<p>Please see our <a href=\"/pages/returns-refunds\">Returns & Refunds</a> page for eligibility, timeframes and how to start a return.</p>" } },
        { "type": "question", "settings": { "question": "How do I choose the right size?", "answer": "<p>Each product page lists the available sizes. For FrostLayer, select the size that matches your mattress. If you’re unsure, contact us before ordering and we’ll gladly help.</p>" } },
        { "type": "question", "settings": { "question": "How do I contact CLIMORA?", "answer": "<p>Use the form on our <a href=\"/pages/contact\">Contact</a> page and we’ll get back to you as soon as possible during business hours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
