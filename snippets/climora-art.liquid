{%- comment -%}
  Brand line-art illustrations used as elegant fallbacks when no photography
  has been uploaded yet. Inherits colour from `currentColor`, accents in Electric Ice.
  Usage: {% render 'climora-art', kind: 'fan' %}
  kind: fan | pillow | topper | orbit | mark
  To pick art from a product automatically: {% render 'climora-art', product: product %}
{%- endcomment -%}
{%- liquid
  assign art_kind = kind
  if product and art_kind == blank
    assign h = product.handle | append: ' ' | append: product.type | append: ' ' | append: product.title | downcase
    if h contains 'fan' or h contains 'solar' or h contains 'air'
      assign art_kind = 'fan'
    elsif h contains 'pillow' or h contains 'icesoft'
      assign art_kind = 'pillow'
    else
      assign art_kind = 'topper'
    endif
  endif
  if art_kind == blank
    assign art_kind = 'orbit'
  endif
-%}
{%- case art_kind -%}
  {%- when 'mark' -%}
    <svg class="wordmark__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="13.5" stroke="currentColor" stroke-width="1.8"/>
      <path d="M8.5 13.5c2.5-2.6 5-2.6 7.5 0s5 2.6 7.5 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path class="accent" d="M8.5 19c2.5-2.6 5-2.6 7.5 0s5 2.6 7.5 0" stroke="#78C8F5" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  {%- when 'fan' -%}
    <svg class="art art--fan {{ class }}" viewBox="0 0 200 200" fill="none" role="img" aria-label="{{ 'general.art.fan' | t }}" focusable="false">
      <ellipse cx="100" cy="182" rx="58" ry="5" fill="currentColor" opacity=".12"/>
      <circle cx="100" cy="86" r="64" fill="#78C8F5" opacity=".12"/>
      <g stroke="currentColor" stroke-width="1" opacity=".22">
        <path d="M158 86h-46M150.2 115l-39.8-23M129 136.2l-23-39.8M100 144V98M71 136.2l23-39.8M49.8 115l39.8-23M42 86h46M49.8 57l39.8 23M71 35.8l23 39.8M100 28v46M129 35.8l-23 39.8M150.2 57l-39.8 23"/>
      </g>
      <circle cx="100" cy="86" r="32" stroke="currentColor" stroke-width="1.2" opacity=".25"/>
      <circle cx="100" cy="86" r="46" stroke="currentColor" stroke-width="1.2" opacity=".35"/>
      <g class="art__blades" style="transform-origin:100px 86px">
        <path d="M100 86c-5-20 2-41 21-44 11 3 6 25-21 44Z" fill="#78C8F5" opacity=".85"/>
        <path d="M100 86c-5-20 2-41 21-44 11 3 6 25-21 44Z" fill="#78C8F5" opacity=".6" transform="rotate(120 100 86)"/>
        <path d="M100 86c-5-20 2-41 21-44 11 3 6 25-21 44Z" fill="#78C8F5" opacity=".4" transform="rotate(240 100 86)"/>
      </g>
      <circle cx="100" cy="86" r="58" stroke="currentColor" stroke-width="3"/>
      <circle cx="100" cy="86" r="9" fill="currentColor"/>
      <circle cx="100" cy="86" r="3" fill="#78C8F5"/>
      <rect x="95" y="144" width="10" height="18" rx="3" fill="currentColor" opacity=".85"/>
      <rect x="54" y="160" width="92" height="18" rx="9" fill="currentColor"/>
      <rect x="64" y="164" width="44" height="10" rx="2" fill="#78C8F5" opacity=".9"/>
      <path d="M75 164v10M86 164v10M97 164v10M64 169h44" stroke="#fff" stroke-opacity=".55" stroke-width="1"/>
      <circle cx="130" cy="169" r="2.6" fill="#78C8F5"/>
      <g stroke="#78C8F5" stroke-width="2.4" stroke-linecap="round">
        <path d="M170 66c6 4 12 4 18 0" opacity=".9"/>
        <path d="M172 84c6 4 12 4 18 0" opacity=".6"/>
        <path d="M170 102c6 4 12 4 18 0" opacity=".35"/>
      </g>
      <g stroke="#78C8F5" stroke-width="1.6" stroke-linecap="round" opacity=".8">
        <circle cx="38" cy="30" r="7"/>
        <path d="M38 17v-4M38 47v-4M25 30h-4M55 30h-4M28.8 20.8 26 18M50 42l-2.8-2.8M28.8 39.2 26 42M50 18l-2.8 2.8"/>
      </g>
    </svg>
  {%- when 'pillow' -%}
    <svg class="art art--pillow {{ class }}" viewBox="0 0 200 200" fill="none" role="img" aria-label="{{ 'general.art.pillow' | t }}" focusable="false">
      <ellipse cx="100" cy="172" rx="66" ry="6" fill="currentColor" opacity=".12"/>
      <ellipse cx="100" cy="100" rx="84" ry="64" fill="#78C8F5" opacity=".1"/>
      <path d="M32 70c-2-14 12-22 28-20 26-4 54-4 80 0 16-2 30 6 28 20 4 22 4 42 0 62 2 14-12 22-28 18-26 4-54 4-80 0-16 4-30-4-28-18-4-20-4-40 0-62Z" fill="currentColor" fill-opacity=".07" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <rect x="46" y="62" width="108" height="76" rx="20" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 6" opacity=".35"/>
      <g stroke="#78C8F5" stroke-width="3" stroke-linecap="round">
        <path d="M60 90c5-6 15-6 20 0s15 6 20 0 15-6 20 0 15 6 20 0" opacity=".95"/>
        <path d="M60 104c5-6 15-6 20 0s15 6 20 0 15-6 20 0 15 6 20 0" opacity=".6"/>
        <path d="M60 118c5-6 15-6 20 0s15 6 20 0 15-6 20 0 15 6 20 0" opacity=".3"/>
      </g>
      <g stroke="#78C8F5" stroke-width="1.6" stroke-linecap="round" opacity=".85">
        <path d="M166 22v28M153.9 29l24.2 14M153.9 43l24.2-14M161 25l5 3 5-3M161 47l5-3 5 3"/>
      </g>
    </svg>
  {%- when 'topper' -%}
    <svg class="art art--topper {{ class }}" viewBox="0 0 200 200" fill="none" role="img" aria-label="{{ 'general.art.topper' | t }}" focusable="false">
      <ellipse cx="102" cy="160" rx="78" ry="7" fill="currentColor" opacity=".12"/>
      <ellipse cx="100" cy="100" rx="88" ry="58" fill="#78C8F5" opacity=".1"/>
      <path d="M26 104 110 66l66 30-84 38-66-30Z" fill="currentColor" fill-opacity=".07" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <path d="M26 104l66 30v18l-66-30v-18Z" fill="currentColor" fill-opacity=".18" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <path d="M92 134l84-38v18l-84 38v-18Z" fill="currentColor" fill-opacity=".1" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <g stroke="#78C8F5" stroke-width="1.4" stroke-dasharray="3 5" opacity=".75">
        <path d="M47 94.5l66 30M68 85l66 30M89 75.5l66 30"/>
        <path d="M48 114l84-38M70 124l84-38"/>
      </g>
      <g fill="#78C8F5">
        <circle cx="69.5" cy="104.5" r="2"/><circle cx="91" cy="95" r="2"/><circle cx="112" cy="85.5" r="2"/>
        <circle cx="91" cy="114.5" r="2"/><circle cx="112.5" cy="105" r="2"/><circle cx="133.5" cy="95.5" r="2"/>
      </g>
      <g stroke="#78C8F5" stroke-width="2.4" stroke-linecap="round">
        <path d="M66 52c6-5 12-5 18 0s12 5 18 0" opacity=".9"/>
        <path d="M92 38c6-5 12-5 18 0s12 5 18 0" opacity=".6"/>
        <path d="M118 24c6-5 12-5 18 0s12 5 18 0" opacity=".35"/>
      </g>
      <g stroke="#78C8F5" stroke-width="1.6" stroke-linecap="round" opacity=".85">
        <path d="M34 34v24M23.6 40l20.8 12M23.6 52l20.8-12"/>
      </g>
    </svg>
  {%- else -%}
    <svg class="art art--orbit {{ class }}" viewBox="0 0 200 200" fill="none" role="img" aria-label="{{ 'general.art.brand' | t }}" focusable="false">
      <circle cx="100" cy="100" r="86" stroke="currentColor" stroke-width="1" opacity=".18"/>
      <circle cx="100" cy="100" r="64" stroke="currentColor" stroke-width="1" stroke-dasharray="2 6" opacity=".3"/>
      <circle cx="100" cy="100" r="40" fill="#78C8F5" opacity=".14"/>
      <circle cx="100" cy="100" r="40" stroke="currentColor" stroke-width="2.5"/>
      <path d="M78 94c7-7 15-7 22 0s15 7 22 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M78 108c7-7 15-7 22 0s15 7 22 0" stroke="#78C8F5" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="164" cy="100" r="4" fill="#78C8F5"/>
      <circle cx="54.7" cy="54.7" r="3" fill="currentColor" opacity=".5"/>
    </svg>
{%- endcase -%}
