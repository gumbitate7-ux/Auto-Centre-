<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_navy | default: '#182A40' }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.load_google_fonts -%}
      {{ 'sora-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'manrope-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      <style>
        @font-face { font-family: "Sora"; font-style: normal; font-weight: 400 600; font-display: swap; src: url("{{ 'sora-latin.woff2' | asset_url }}") format("woff2"); }
        @font-face { font-family: "Manrope"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("{{ 'manrope-latin.woff2' | asset_url }}") format("woff2"); }
      </style>
    {%- endif -%}

    {{ 'climora.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --c-navy: {{ settings.color_navy | default: '#182A40' }};
        --c-ice: {{ settings.color_ice | default: '#EAF5FF' }};
        --c-electric: {{ settings.color_electric | default: '#78C8F5' }};
        --c-silver: {{ settings.color_silver | default: '#BFCBD5' }};
        --c-charcoal: {{ settings.color_charcoal | default: '#111820' }};
      }
    </style>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'climora.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: routes.root_url | json }},
        {%- if settings.logo != blank %}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
        {%- endif %}
        "areaServed": "ZA",
        "slogan": {{ settings.brand_tagline | default: 'The Future of Staying Cool.' | json }}
        {%- assign sameas = '' -%}
        {%- if settings.social_instagram != blank -%}{%- assign sameas = sameas | append: settings.social_instagram | append: '|' -%}{%- endif -%}
        {%- if settings.social_facebook != blank -%}{%- assign sameas = sameas | append: settings.social_facebook | append: '|' -%}{%- endif -%}
        {%- if settings.social_tiktok != blank -%}{%- assign sameas = sameas | append: settings.social_tiktok | append: '|' -%}{%- endif -%}
        {%- if settings.social_youtube != blank -%}{%- assign sameas = sameas | append: settings.social_youtube | append: '|' -%}{%- endif -%}
        {%- if sameas != '' -%},
        "sameAs": {{ sameas | split: '|' | json }}
        {%- endif %}
      }
    </script>
    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
            "query-input": "required name=search_term_string"
          }
        }
      </script>
    {%- endif -%}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'climora-cart-drawer' %}

    <div class="toast" role="status" aria-live="polite" data-toast>
      {%- render 'icon', name: 'check-circle' -%}<span data-toast-text></span>
    </div>

    <script>
      window.Climora = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartJs: {{ routes.cart_url | append: '.js' | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | default: 'drawer' | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          added: {{ 'cart.added' | t | json }},
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          error: {{ 'cart.error' | t | json }},
          setAdded: {{ 'bundles.added' | t | json }}
        }
      };
    </script>
  </body>
</html>
