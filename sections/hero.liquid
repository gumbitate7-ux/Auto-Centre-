{%- liquid
  assign featured = section.settings.product
  if featured == blank
    assign featured = all_products['wallet-tracker-card-2-pack']
  endif
  if featured.id == blank
    assign featured = collections.all.products.first
  endif
  if featured.id != blank
    assign cta_url = featured.url
    assign price_label = featured.price | money_without_trailing_zeros
  else
    assign cta_url = routes.all_products_collection_url
    assign price_label = 'R599'
  endif
  if section.settings.button_link != blank
    assign cta_url = section.settings.button_link
  endif
-%}
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--pill">{% render 'icon', name: 'pin', size: 16 %} {{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
      {%- if section.settings.points != blank -%}
        <ul class="check-list hero__points" role="list">
          {%- for point in points -%}
            {%- assign p = point | strip -%}
            {%- if p != blank -%}
              <li>{% render 'icon', name: 'check', size: 18, stroke: 2.4 %}<span>{{ p }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero__cta">
        <a href="{{ cta_url }}" class="btn btn--primary btn--lg">
          {{ section.settings.button_label }} &mdash; {{ price_label }}
          {% render 'icon', name: 'arrow-right', size: 18 %}
        </a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#how-it-works' }}" class="btn btn--ghost btn--lg">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      <ul class="hero__assure" role="list">
        <li>{% render 'icon', name: 'truck', size: 18 %} {% if settings.free_shipping %}Free{% else %}Tracked{% endif %} {{ settings.courier_name }} delivery</li>
        <li>{% render 'icon', name: 'return', size: 18 %} {{ settings.returns_days }}-day returns</li>
        <li>{% render 'icon', name: 'lock', size: 18 %} Secure Yoco checkout</li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'hero__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 520px, 90vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          <img
            class="hero__image"
            src="{{ 'hero-tracker-card.jpg' | asset_url }}"
            alt="Slim black tracker card standing upright"
            width="521"
            height="597"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      {%- if section.settings.show_floats -%}
        <div class="hero__float hero__float--alert" aria-hidden="true">
          <span class="hero__float-icon">{% render 'icon', name: 'sound', size: 18 %}</span>
          <span>
            <strong>Wallet</strong>
            <small>Nearby &middot; playing sound</small>
          </span>
        </div>
        <div class="hero__float hero__float--thin" aria-hidden="true">
          <strong>2&nbsp;mm</strong>
          <small>thin as a bank card</small>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled product photo." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Works with the Apple Find My app" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wallet, back on the map." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A tracker as thin as a bank card. Slip it into your wallet, see it in Find My on your iPhone, and ring it when it's hiding under the couch cushions.</p>"
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "Bullet points",
      "info": "One per line",
      "default": "Two cards in every pack\nLeft-behind alerts before you drive off\nNo subscription, no monthly fees"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the 2-pack" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the product." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "show_floats", "label": "Show floating info tags", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
