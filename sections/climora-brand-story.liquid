<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}" aria-labelledby="StoryTitle-{{ section.id }}">
  <div class="container">
    <div class="story on-dark" data-reveal>
      <div class="story__orb" aria-hidden="true"></div>
      <div class="story__grid">
        <div class="story__content">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="story__title" id="StoryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<div class="story__text rte">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <ul class="story__pillars" role="list">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <div><a class="btn btn--light" href="{{ section.settings.button_link | default: '/pages/about' }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow-right' %}</a></div>
          {%- endif -%}
        </div>
        <div class="story__media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.image.alt }}
          {%- else -%}
            <div style="position:absolute;inset:10%">{% render 'climora-art', kind: 'orbit' %}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "div",
  "class": "section-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "COMFORT IS EVOLVING." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>At CLIMORA, we believe staying comfortable should be easier, smarter and more accessible. We bring together innovative cooling solutions designed to help you navigate warmer days and enjoy more comfortable nights.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": false }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "text", "label": "Caption", "default": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Days", "text": "Portable airflow" } },
        { "type": "pillar", "settings": { "title": "Nights", "text": "Sleep cooling" } },
        { "type": "pillar", "settings": { "title": "ZA", "text": "South African brand" } }
      ]
    }
  ]
}
{% endschema %}
