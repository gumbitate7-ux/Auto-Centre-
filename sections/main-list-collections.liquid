<section class="section">
  <div class="container">
    <header class="section-head">
      <h1 class="h1">Shop</h1>
    </header>
    <div class="product-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="product-card card">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}
              <img src="{{ 'tracker-card-find-anywhere.jpg' | asset_url }}" alt="" width="851" height="851" loading="lazy">
            {%- endif -%}
          </div>
          <div class="product-card__info">
            <h2 class="product-card__title">{{ collection.title }}</h2>
            <span class="muted">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-list-collections",
  "settings": []
}
{% endschema %}
