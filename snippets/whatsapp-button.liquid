{%- if settings.show_whatsapp_button and settings.whatsapp_number != blank -%}
  {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
  <a
    class="whatsapp-float"
    href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat to us on WhatsApp"
  >
    {% render 'icon', name: 'whatsapp', size: 28 %}
    <span class="whatsapp-float__label">Chat to us</span>
  </a>
{%- endif -%}
