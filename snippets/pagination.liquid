{%- comment -%} Accepts: paginate {%- endcomment -%}
<nav aria-label="{{ 'general.pagination' | t }}">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
      <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous_page' | t }}">{% render 'icon', name: 'arrow-left' %}</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.next_page' | t }}">{% render 'icon', name: 'arrow-right' %}</a></li>
    {%- endif -%}
  </ul>
</nav>
