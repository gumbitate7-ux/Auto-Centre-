<section
  class="section image-text image-text--{{ section.settings.layout }} section--{{ section.settings.background }}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
>
  <div class="container image-text__grid">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'image-text__image',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 560px, 92vw',
            loading: 'lazy'
        }}
      {%- else -%}
        <img
          class="image-text__image"
          src="{{ section.settings.fallback_image | asset_url }}"
          alt="{{ section.settings.fallback_alt | escape }}"
          width="851"
          height="851"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte image-text__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.points != blank -%}
        {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
        <ul class="check-list" role="list">
          {%- for point in points -%}
            {%- assign p = point | strip -%}
            {%- if p != blank -%}
              <li>{% render 'icon', name: 'check', size: 18, stroke: 2.4 %}<span>{{ p }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style }}">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right', size: 18 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Bundled image (used when no image is picked)",
      "options": [
        { "value": "tracker-card-play-sound.jpg", "label": "Play a sound" },
        { "value": "tracker-card-left-behind-alert.jpg", "label": "Left-behind alert" },
        { "value": "tracker-card-2mm-slim.jpg", "label": "2 mm slim" },
        { "value": "tracker-card-find-anywhere.jpg", "label": "Find anywhere" }
      ],
      "default": "tracker-card-play-sound.jpg"
    },
    { "type": "text", "id": "fallback_alt", "label": "Bundled image description", "default": "Tracker card ringing from the Find My app" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ring it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Under the couch? Ask it to beep." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tap Play Sound in the Find My app and the card chirps until you find it.</p>"
    },
    { "type": "textarea", "id": "points", "label": "Bullet points", "info": "One per line" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "secondary"
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets menus link straight to this section, e.g. how-it-works" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
