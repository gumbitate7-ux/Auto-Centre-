{%- if section.settings.show -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    <div class="container announcement__inner">
      <span>{{ section.settings.text | escape }}</span>
      {%- if section.settings.link_label != blank -%}
        <span class="announcement__sep" aria-hidden="true"></span>
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Discover a cooler way to live" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop CLIMORA" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
