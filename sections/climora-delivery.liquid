<section class="section {{ section.settings.background }}{% if section.settings.tight %} section--tight{% endif %}" aria-labelledby="DeliveryTitle-{{ section.id }}">
  <div class="container">
    <div class="delivery" data-reveal>
      <div class="stack">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h3" id="DeliveryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="text-muted">{{ settings.delivery_message | default: 'Your CLIMORA order will be delivered through our courier partner, Aramex. Estimated delivery is 5–10 business days, subject to order processing and courier collection.' | escape }}</p>
        {%- if section.settings.link_label != blank -%}
          <div><a class="link-arrow" href="{{ section.settings.link | default: '/pages/shipping-delivery' }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow-right' %}</a></div>
        {%- endif -%}
      </div>
      <ul class="delivery__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="delivery__step" {{ block.shopify_attributes }}>
            {%- render 'icon', name: block.settings.icon -%}
            <span><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Delivery & trust",
  "tag": "div",
  "class": "section-delivery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Delivery & checkout" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop with confidence." },
    { "type": "paragraph", "content": "The delivery message is edited once in Theme settings → Delivery, so it stays consistent across the store." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shipping & delivery details" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "background", "label": "Background", "default": "section--mist", "options": [{ "value": "", "label": "White" }, { "value": "section--mist", "label": "Mist" }, { "value": "section--ice", "label": "Ice gradient" }] },
    { "type": "checkbox", "id": "tight", "label": "Compact spacing", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "lock", "label": "Lock" }, { "value": "shield", "label": "Shield" }, { "value": "return", "label": "Returns" }, { "value": "chat", "label": "Support" }, { "value": "box", "label": "Box" }, { "value": "clock", "label": "Clock" }, { "value": "card", "label": "Card" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "text", "label": "Text", "default": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delivery & trust",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Aramex delivery", "text": "Estimated 5–10 business days" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted Shopify checkout" } },
        { "type": "item", "settings": { "icon": "return", "title": "Clear returns policy", "text": "Know your options before you buy" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Real support", "text": "Questions answered by our team" } }
      ]
    }
  ]
}
{% endschema %}
